{
  "compilerOptions": {
    "target": "ES2018",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "types": []
  },
  "include": [
    "*.ts"
  ],
  "exclude": [
    "tests",
    "node_modules",
    "dist"
  ]
}
